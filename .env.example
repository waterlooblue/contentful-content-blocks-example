# Copy this file to .env and fill in your Contentful details.
# Find them in Contentful under Settings → API keys.
VITE_CONTENTFUL_SPACE_ID="Your space id"
VITE_CONTENTFUL_ENVIRONMENT=master

# Content Delivery API token (published content).
VITE_CONTENTFUL_ACCESS_TOKEN="Your Content Delivery API access token"

# Optional: set VITE_CONTENTFUL_PREVIEW=true and add a Content Preview API token
# to see draft content. Only do this for local or private preview builds, as the
# token ends up in the browser bundle.
VITE_CONTENTFUL_PREVIEW=false
VITE_CONTENTFUL_PREVIEW_ACCESS_TOKEN=
